# ============================================================
# Ryder — environment configuration
# Copy to .env (or export in your shell / paste into docker-compose)
# and restart. Every key is OPTIONAL — without it the built-in
# fallback keeps the whole platform working in demo mode.
# ============================================================

# ---- core ----
# PORT=4321
# NODE_ENV=production
# RYDER_SECRET=change-me-64-random-chars          # REQUIRED in production

# ---- Google Maps (real place search + road distance/traffic ETA) ----
# Console: https://console.cloud.google.com → enable "Places API" and
# "Directions API" → create API key (restrict to those two APIs).
# GOOGLE_MAPS_API_KEY=AIza...

# ---- Twilio (real OTP SMS; demo OTPs disappear from responses) ----
# Console: https://console.twilio.com → Account SID + Auth Token,
# buy/verify a sender number.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+1xxxxxxxxxx
# RYDER_EXPOSE_DEMO_OTP=false                     # flip once SMS works

# ---- Razorpay (real wallet top-ups) ----
# Dashboard: https://dashboard.razorpay.com → API keys; add a webhook to
# https://<your-host>/api/webhooks/razorpay for event payment.captured
# with a webhook secret.
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...

# ---- tuning (defaults are sensible) ----
# RYDR_TIME_SCALE=18            # bot fleet speed multiplier (1 = real time)
# RYDER_BOT_FLEET=true
# RL_API_PER_MIN=240
# LOG_LEVEL=info
